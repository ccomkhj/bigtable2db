   "tenant_agg": {
    "sql": "SELECT period, count() AS cnt, sum(quantity * price) AS revenue, avg(score) AS avg_score FROM big_table FINAL WHERE tenant_id = {p0:Int32} GROUP BY period ORDER BY period",
